# Foresight · переменные окружения docker compose. Скопируйте в .env (он в .gitignore) и поменяйте пароли:
#   cp .env.example .env

# ---- observability: Prometheus и Grafana (docker-compose.yml) -----------------------------------------------
# Пароль администратора Grafana (обязателен; анонимный доступ — только просмотр дашбордов).
# `make up` / `make demo` при первом запуске создают .env из этого файла со случайным паролем.
GF_SECURITY_ADMIN_PASSWORD=change-me
# GF_SECURITY_ADMIN_USER=admin
# Порты на хосте, можно с адресом (127.0.0.1:3000 — только локально).
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090

# ---- сервисы (docker-compose.yml) -----------------------------------------------------------------------
# FORESIGHT_DB_PASSWORD=foresight
# FORESIGHT_LOG_LEVEL=info
# API_PORT=8000
# INGEST_PORT=8001
# PREDICTOR_PORT=8002
# NDTP_PORT=9201
# EMULATOR_PORT=18080
# DASHBOARD_PORT=8080
# DASHBOARD_API_MODE=live       # mock — демо-данные без backend
# DASHBOARD_TILES_URL=          # none — карта без подложки (стенд без интернета)
# DASHBOARD_ADMIN_PASSWORD=     # если стенд открыт наружу: изменения в «Администрировании» — под паролем (пользователь admin)
